{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WhatsAman",
  "version": "1.0.0",
  "identifier": "studio.amankerja.whatsaman",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "title": "WhatsAman — WhatsApp Dashboard by Aman Kerja Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
