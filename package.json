{
  "name": "whatsaman",
  "version": "1.0.0",
  "description": "WhatsAman — WhatsApp Dashboard by Aman Kerja Studio",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n \"CORE,UI\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:ui\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:ui": "npm --prefix ui run dev",
    "dev:tauri": "tauri dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "ui:build": "npm --prefix ui run build",
    "tauri:build": "tauri build"
  },
  "keywords": [],
  "author": "Aman Kerja Studio",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
