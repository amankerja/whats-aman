{
  "server": {
    "port": 3000,
    "host": "127.0.0.1",
    "corsOrigins": ["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]
  },
  "storage": {
    "dataDir": "./data",
    "databaseFile": "./data/database.sqlite",
    "sessionsDir": "./data/sessions",
    "mediaDir": "./data/media",
    "backupsDir": "./data/backups",
    "exportsDir": "./data/exports"
  },
  "whatsapp": {
    "defaultBrowser": ["WhatsAman", "Desktop", "1.0.0"],
    "syncFullHistory": false,
    "qrCodeTimeoutMs": 60000,
    "reconnectMaxRetries": 5
  },
  "campaign": {
    "defaultRateLimitPerMin": 20,
    "defaultDelayMinSec": 5,
    "defaultDelayMaxSec": 15,
    "batchPauseAfter": 50,
    "batchPauseSeconds": 60
  }
}
